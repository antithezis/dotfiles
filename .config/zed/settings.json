// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette
{
  "features": {
    "edit_prediction_provider": "supermaven"
  },
  "icon_theme": "Zed (Default)",
  // "show_edit_predictions": true,
  "diagnostics": {
    "include_warnings": false,
    "inline": {
      "enabled": true,
      "update_debounce_ms": 150,
      "padding": 4,
      "min_column": 0,
      "max_severity": null
    }
  },
  "assistant": {
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4o"
    },
    "version": "2"
  },
  "experimental.theme_overrides": {
    "syntax": {
      "function": {
        "font_style": "italic"
      },
      "keyword": {
        "font_style": "italic"
      },
      "comment": {
        "font_style": "italic"
      },
      "string": {
        "font_style": "italic"
      }
    }
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "vertical_scroll_margin": 8,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Rosé Pine Moon"
  },

  "file_types": {
    "HTML": ["angular"]
  },

  "vim_mode": true,
  "buffer_font_family": "DankMono Nerd Font",
  "cursor_blink": false,
  "scrollbar": {
    "show": "never"
  },

  "buffer_line_height": {
    "custom": 1.5
  },

  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
    "font_size": 16
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  }
}
