# =============================================================================
# 5. HISTORY CONFIGURATION
# =============================================================================
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt HIST_IGNORE_ALL_DUPS  # No guardar duplicados
setopt HIST_IGNORE_SPACE     # Ignorar comandos que empiezan con espacio
setopt HIST_SAVE_NO_DUPS     # No guardar duplicados al salir
setopt HIST_REDUCE_BLANKS    # Eliminar espacios en blanco innecesarios
setopt SHARE_HISTORY         # Compartir historial entre sesiones
setopt APPEND_HISTORY        # Añadir al historial, no sobrescribir
setopt INC_APPEND_HISTORY    # Añadir comandos inmediatamente

# =============================================================================
# 6. KEY BINDINGS & INTERACTION
# =============================================================================
# Aceptar sugerencias de autosuggestions con Ctrl-Y
bindkey '^Y' autosuggest-accept

# Búsqueda en historial basada en el texto ya escrito (Ctrl+P / Ctrl+N)
autoload -U history-search-end
zle -N history-beginning-search-backward-end history-search-end
zle -N history-beginning-search-forward-end history-search-end
bindkey '^P' history-beginning-search-backward-end  # Ctrl+P: buscar hacia atrás
bindkey '^N' history-beginning-search-forward-end   # Ctrl+N: buscar hacia adelante

# Función mejorada para historial con fzf (CTRL-H)
if command -v fzf &> /dev/null; then
  fzf-history() {
    local selected
    selected=$(fc -rl 1 | fzf --tac --no-sort --tiebreak=index --query="$LBUFFER")
    if [[ -n $selected ]]; then
      LBUFFER=$(echo $selected | sed 's/^[ ]*[0-9]*[ ]*//')
      zle redisplay
    fi
  }
  zle -N fzf-history
  bindkey '^H' fzf-history
fi

# Cargar key bindings y autocompletado de fzf
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
if [[ -f /opt/homebrew/opt/fzf/shell/key-bindings.zsh ]]; then
  source /opt/homebrew/opt/fzf/shell/key-bindings.zsh
  source /opt/homebrew/opt/fzf/shell/completion.zsh
fi

